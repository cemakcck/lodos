MONGODB_URI=mongodb://localhost:27018/lodos?replicaSet=rs0&directConnection=true
SESSION_SECRET=dev-only-insecure-secret-change-me-0123456789
DEMO_MODE=1
WEB_ORIGIN=http://localhost:5180
PORT=4100
# Behind a reverse proxy (production): which hops to trust for the client address used by the per-IP limits.
# "false" (default: X-Forwarded-For is ignored), "true", a hop count such as "1", or a comma-separated list of the
# proxies' IPs / CIDRs such as "10.0.0.0/8,127.0.0.1". Leave it false when the API is reached directly.
TRUST_PROXY=false
# Session and sandbox cookies get the Secure flag (HTTPS only). Defaults to NODE_ENV === "production"; set it to 0
# only for a production build served over plain HTTP on localhost.
# COOKIE_SECURE=1
